# Server-only values. Run one worker. Paths are relative to backend/.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# Node launchers wait for saved-history integrity verification (30–1800 seconds).
BACKEND_STARTUP_TIMEOUT_SECONDS=600
# Optional built UI directory; npm start sets the absolute frontend/dist path.
FRONTEND_DIST=
PERSISTENCE_MODE=local
AUTH_MODE=local
SESSION_SECRET=
DEMO_PASSPHRASE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Vertex uses Google Cloud credentials; developer uses GEMINI_API_KEY.
LLM_MODE=gemini
GEMINI_BACKEND=vertex
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For unattended local/server access, point to a service-account JSON outside Git.
# Restrict the JSON to its owner (chmod 600); never place it in frontend/.
# Otherwise use: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
# Gemini 3.5 Flash-Lite (Google Gemini API model ID).
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CONCURRENCY=4
LLM_REQUEST_TIMEOUT_SECONDS=8
LLM_REQUESTS_PER_MINUTE=30
LLM_MAX_OUTPUT_TOKENS=512
LLM_SESSION_TOKEN_BUDGET=200000
# Separate allowance for each user-requested event, including corrections/retries.
LLM_EVENT_TOKEN_BUDGET=100000
SIM_BASE_TICKS_PER_SECOND=20
SIM_MAX_AGENTS=100
SIM_MAX_RUNNING=1
AUTOSAVE_INTERVAL_TICKS=200
# Optional server-only Tiger read model; local persistence remains authoritative.
TIGER_ENABLED=false
TIGER_DATABASE_URL=
TIGER_SCHEMA=agentcity_tiger
TIGER_TIMEOUT_SECONDS=10
TIGER_REVISION_BATCH=4
TIGER_MOVEMENT_SAMPLE_TICKS=2
TIGER_POLL_SECONDS=5
TIGER_RETRY_MIN_SECONDS=1
TIGER_RETRY_MAX_SECONDS=60
# Snowflake SQL API / Cortex, key-pair JWT only (see snowflake-handoff.md).
SNOWFLAKE_ENABLED=false
# Automatic observations use a separate, opt-in warehouse read model.
# Run backend/app/snowflake/sql/003_observations.sql before enabling.
SNOWFLAKE_OBSERVATIONS_ENABLED=false
SNOWFLAKE_OBSERVATION_POLL_SECONDS=30
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b
SNOWFLAKE_DEADLINE_SECONDS=30
# Filling credentials alone does not enable adapters.

# ElevenLabs narration (server-side only; no cloning or browser credentials).
ENABLE_NARRATION=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional distinct existing account voices, assigned stably per citizen.
ELEVENLABS_CHARACTER_VOICE_IDS=
# Live voices keep existing assignments usable when this pool is exhausted.
# Each selected voice is checked server-side; no cloning or automatic remapping.
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Absolute browser origin for audio_url behind a proxy; no path.
NARRATION_PUBLIC_ORIGIN=
NARRATION_DEADLINE_SECONDS=20
NARRATION_MAX_CONCURRENCY=2
NARRATION_REQUESTS_PER_MINUTE=10
NARRATION_MAX_CHARACTERS=2500
NARRATION_MAX_AUDIO_BYTES=4194304
NARRATION_CACHE_MAX_BYTES=67108864
NARRATION_CACHE_MAX_ENTRIES=256
NARRATION_CACHE_TTL_SECONDS=86400
NARRATION_URL_TTL_SECONDS=900

# DATABASE_URL is not consumed. Use TIGER_DATABASE_URL with a TLS hostname and
# sslrootcert (provider CA or system CA). sslmode=verify-full is enforced.

# Snowflake: key-pair JWT configuration consumed by the adapter.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Password/token/authenticator fields are not consumed; key-pair JWT only.
# Store key material outside Git; use absolute local paths.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=

# Optional original ElevenLabs disaster library; each category is independent.
# Requires ENABLE_NARRATION=true and the existing authorized API key.
# Default suites and development never make sound/music/reaction provider calls.
ENABLE_DISASTER_EFFECTS=false
ENABLE_DISASTER_MUSIC=false
ENABLE_DISASTER_REACTIONS=false
ELEVENLABS_EFFECTS_MODEL=eleven_text_to_sound_v2
ELEVENLABS_MUSIC_MODEL=music_v1
ELEVENLABS_REACTIONS_MODEL=eleven_v3
DISASTER_AUDIO_DEADLINE_SECONDS=60

# Commit running worlds every five simulated seconds.
PERSIST_INTERVAL_SECONDS=5
