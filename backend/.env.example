# Server-only values. Run one worker. Paths are relative to backend/.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# Optional built UI directory; npm start sets the absolute frontend/dist path.
FRONTEND_DIST=
PERSISTENCE_MODE=local
AUTH_MODE=local
SESSION_SECRET=
DEMO_PASSPHRASE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Vertex uses Google Cloud credentials; developer uses GEMINI_API_KEY.
LLM_MODE=gemini
GEMINI_BACKEND=vertex
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For unattended local/server access, point to a service-account JSON outside Git.
# Restrict the JSON to its owner (chmod 600); never place it in frontend/.
# Otherwise use: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
# Gemini 3.5 Flash-Lite (Google Gemini API model ID).
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CONCURRENCY=4
LLM_REQUEST_TIMEOUT_SECONDS=8
LLM_REQUESTS_PER_MINUTE=30
LLM_MAX_OUTPUT_TOKENS=512
LLM_SESSION_TOKEN_BUDGET=200000
SIM_BASE_TICKS_PER_SECOND=2
SIM_MAX_AGENTS=100
SIM_MAX_RUNNING=1
AUTOSAVE_INTERVAL_TICKS=20
# Optional server-only Tiger read model; local persistence remains authoritative.
TIGER_ENABLED=false
TIGER_DATABASE_URL=
TIGER_SCHEMA=agentcity_tiger
TIGER_TIMEOUT_SECONDS=10
TIGER_REVISION_BATCH=4
TIGER_MOVEMENT_SAMPLE_TICKS=2
TIGER_POLL_SECONDS=5
TIGER_RETRY_MIN_SECONDS=1
TIGER_RETRY_MAX_SECONDS=60
# Snowflake SQL API / Cortex, key-pair JWT only (see snowflake-handoff.md).
SNOWFLAKE_ENABLED=false
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b
# Narration awaits its separate implementation branch.
ENABLE_NARRATION=false

# Filling credentials alone does not enable adapters.

# ElevenLabs narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# DATABASE_URL is not consumed. Use TIGER_DATABASE_URL with a TLS hostname and
# sslrootcert (provider CA or system CA). sslmode=verify-full is enforced.

# Snowflake: key-pair JWT configuration consumed by the adapter.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Password/token/authenticator fields are not consumed; key-pair JWT only.
# Store key material outside Git; use absolute local paths.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=
