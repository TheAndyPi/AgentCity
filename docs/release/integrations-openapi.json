  "info": {
    "title": "AgentCity integrations",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/snowflake/comparisons": {
      "post": {
        "description": "Two explicit owned history revisions. No caller SQL. The parent session cookie, allowed Origin, CSRF token, and canonical UUID idempotency key are required for writes. Exact successful retries return the durable receipt; changed bodies conflict.",
        "operationId": "compare_snowflake_comparisons_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Required in session mode; must be allowed.",
            "in": "header",
            "name": "Origin",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComparisonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/app__snowflake__dto__Failure"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Compare"
      }
    },
    "/tiger/status": {
      "get": {
        "operationId": "status_tiger_status_get",
        "parameters": [
          {
