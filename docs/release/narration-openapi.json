    "/v1/simulations/{sid}/dialogue": {
      "post": {
        "summary": "Live Dialogue",
        "description": "Speak only the committed dialogue source at an owned pinned revision. Requires the parent session, CSRF token and UUID Idempotency-Key. No client text is accepted.",
