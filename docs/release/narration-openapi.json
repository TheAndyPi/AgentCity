    "/audio/{audio_id}": {
      "head": {
        "summary": "Audio",
        "description": "Owner-only narration audio. Requires the parent session (or loopback local mode) and the unexpired signature issued by POST /api/v1/simulations/{sid}/narration. Supports a single byte range for browser media playback.",
        "operationId": "head_narration_audio",
        "parameters": [
          {
            "name": "audio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Audio Id"
            }
          },
          {
            "name": "expires",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Expires"
            }
          },
          {
            "name": "signature",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "title": "Signature"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete MP3 audio",
            "content": {
              "audio/mpeg": {}
            }
          },
          "206": {
            "content": {
              "audio/mpeg": {}
            },
            "description": "Requested byte range"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Not Found"
          },
          "416": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Range Not Satisfiable"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Audio",
        "description": "Owner-only narration audio. Requires the parent session (or loopback local mode) and the unexpired signature issued by POST /api/v1/simulations/{sid}/narration. Supports a single byte range for browser media playback.",
        "operationId": "get_narration_audio",
        "parameters": [
          {
            "name": "audio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Audio Id"
            }
          },
          {
