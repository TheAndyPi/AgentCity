{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentCity Snowflake extension",
    "version": "1.0.0"
  },
  "paths": {
    "/snowflake/comparisons": {
      "post": {
        "summary": "Compare",
        "description": "Two explicit owned history revisions. No caller SQL. The parent session cookie, allowed Origin, CSRF token, and canonical UUID idempotency key are required for writes. Exact successful retries return the durable receipt; changed bodies conflict.",
        "operationId": "compare_snowflake_comparisons_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComparisonRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required in session mode; must be allowed."
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "simulation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Simulation Id"
          },
          "revision": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Revision"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "decision"
            ],
            "title": "Kind"
          },
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "tick": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Tick"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "simulation_id",
          "revision",
          "id",
          "kind",
          "record_id",
          "tick",
          "excerpt",
          "url"
        ],
        "title": "Citation"
      },
      "Comparison": {
        "properties": {
          "a": {
            "$ref": "#/components/schemas/Provenance"
          },
          "b": {
            "$ref": "#/components/schemas/Provenance"
          },
          "data_source": {
            "type": "string",
            "enum": [
              "snowflake",
              "local_export"
            ],
            "title": "Data Source"
          },
          "horizon": {
            "type": "string",
            "enum": [
              "equal_endpoint_ticks",
              "unequal_endpoint_ticks"
            ],
            "title": "Horizon"
          },
          "lineage": {
            "type": "string",
            "enum": [
              "same_history",
              "parent_branch",
              "siblings",
              "unrelated"
            ],
            "title": "Lineage"
          },
          "differences": {
            "items": {
              "$ref": "#/components/schemas/Difference"
            },
            "type": "array",
            "title": "Differences"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "explanation": {
            "$ref": "#/components/schemas/Explanation"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "a",
          "b",
          "data_source",
          "horizon",
          "lineage",
          "differences",
          "citations",
          "explanation",
          "limitations"
        ],
        "title": "Comparison"
      },
      "ComparisonRequest": {
        "properties": {
          "a": {
            "$ref": "#/components/schemas/PinnedHistory"
          },
          "b": {
            "$ref": "#/components/schemas/PinnedHistory"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "default": "What recorded differences accompany lower cooperation in B?"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "title": "ComparisonRequest"
      },
      "ComparisonResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "data": {
            "$ref": "#/components/schemas/Comparison"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "data"
        ],
        "title": "ComparisonResponse"
      },
      "Difference": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "A"
          },
          "b": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "B"
          },
          "delta_b_minus_a": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta B Minus A"
          },
          "unit": {
            "type": "string",
            "enum": [
              "population_mean_0_100",
              "recorded_count",
              "resource_units"
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "a",
          "b",
          "delta_b_minus_a",
          "unit"
        ],
        "title": "Difference"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "details"
        ],
        "title": "ErrorBody"
      },
      "Explanation": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "cortex_selection",
              "deterministic"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "status",
          "reason",
          "observations"
        ],
        "title": "Explanation"
      },
      "Failure": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "title": "Failure"
      },
      "Issue": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "title": "Issue"
      },
      "Observation": {
        "properties": {
          "fact_id": {
            "type": "string",
            "title": "Fact Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fact_id",
          "text",
          "citation_ids"
        ],
        "title": "Observation"
      },
      "PinnedHistory": {
        "properties": {
          "simulation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Simulation Id"
          },
          "revision": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "simulation_id",
          "revision"
        ],
        "title": "PinnedHistory"
      },
      "Provenance": {
        "properties": {
          "simulation_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Simulation Id"
          },
          "revision": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Revision"
          },
          "endpoint_tick": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Endpoint Tick"
          },
          "metric_tick": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Metric Tick"
          },
          "metric_revision": {
            "type": "integer",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Metric Revision"
          },
          "sim_time_seconds": {
            "type": "number",
            "title": "Sim Time Seconds"
          },
          "parent_simulation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Simulation Id"
          },
          "fork_ref": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fork Ref"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "contract_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Contract Version",
            "default": "1.0.0"
          },
          "engine_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Engine Version",
            "default": "1.0.0"
          },
          "export_sha256": {
            "type": "string",
            "title": "Export Sha256"
          },
          "ingested_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingested At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "simulation_id",
          "revision",
          "endpoint_tick",
          "metric_tick",
          "metric_revision",
          "sim_time_seconds",
          "parent_simulation_id",
          "fork_ref",
          "seed",
          "export_sha256",
          "ingested_at"
        ],
        "title": "Provenance"
      }
    }
  }
}
