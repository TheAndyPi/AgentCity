    },
    "Inventory": {
      "additionalProperties": false,
      "properties": {
        "food": {
          "minimum": 0,
          "title": "Food",
          "type": "number"
        },
        "supplies": {
          "minimum": 0,
          "title": "Supplies",
          "type": "number"
        },
        "water": {
          "minimum": 0,
          "title": "Water",
          "type": "number"
        }
