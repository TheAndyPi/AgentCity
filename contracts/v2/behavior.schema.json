          "type": "boolean"
        },
        "survival_fraction": {
          "title": "Survival Fraction",
          "type": "number"
        },
        "tiger_behavior_supported": {
          "const": false,
          "title": "Tiger Behavior Supported",
          "type": "boolean"
        },
        "unconscious": {
          "title": "Unconscious",
          "type": "integer"
        }
      },
      "required": [
        "population",
        "living",
        "unconscious",
        "dead",
        "survival_fraction",
        "deaths_by_cause",
