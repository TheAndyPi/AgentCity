# Install outside the checkout: /etc/agentcity/runtime.env, root:agentcity 0640.
HOST=127.0.0.1
PORT=8000
DATA_DIR=/var/lib/agentcity/data
FRONTEND_DIST=/opt/agentcity/current/frontend/dist
AUTH_MODE=session
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEMO_PASSPHRASE=REPLACE_WITH_PRIVATE_DEMO_PASSPHRASE
ALLOWED_ORIGINS=https://city.example.com
PERSISTENCE_MODE=local
LLM_MODE=rules
SIM_MAX_RUNNING=1
SIM_MAX_AGENTS=100
TIGER_ENABLED=false
TIGER_DATABASE_URL=
TIGER_SCHEMA=agentcity_tiger
SNOWFLAKE_ENABLED=false
# See backend/.env.example for voice/model and bounded cache/provider settings.
ENABLE_NARRATION=false
NARRATION_PUBLIC_ORIGIN=https://city.example.com
